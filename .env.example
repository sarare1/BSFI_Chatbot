# Template: copy this file to ".env" and put your real values there.
# Keep real tokens out of this file, because .env.example is meant to be shared.
#
# Hugging Face access token (create one at https://huggingface.co/settings/tokens
# with the "Make calls to Inference Providers" permission). Leave empty to run
# in offline simulation mode.
HF_TOKEN=
# Any open-source chat model available through Hugging Face Inference Providers.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional OTLP/HTTP collector endpoint for OpenTelemetry traces.
# Leave unset to print privacy-safe local spans to the server console.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=northstar-supportbot
